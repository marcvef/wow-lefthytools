<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<!--
		Text field row for the settings list (Builder:TextInput). Same layout as Blizzard's
		controls: label on the left half (SettingsListElementTemplate), control from the middle.
		Mixin in Options.lua.
	-->
	<Frame name="LefthyToolsSettingsTextTemplate" inherits="SettingsListElementTemplate" mixin="LefthyToolsSettingsTextMixin" virtual="true">
		<Size x="280" y="26"/>
		<Frames>
			<EditBox parentKey="EditBox" inherits="InputBoxTemplate" autoFocus="false">
				<Size x="240" y="20"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="CENTER" x="-34" y="0"/>
				</Anchors>
			</EditBox>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!--
		Read-only info row (version, update status) on the overview page: label on the left half,
		value from the middle. Mixin in Options.lua.
	-->
	<Frame name="LefthyToolsSettingsInfoTemplate" inherits="SettingsListElementTemplate" mixin="LefthyToolsSettingsInfoMixin" virtual="true">
		<Size x="280" y="26"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Value" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativePoint="CENTER" x="-34" y="0"/>
						<Anchor point="RIGHT" x="-10" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
